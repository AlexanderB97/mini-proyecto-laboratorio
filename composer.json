{
    "name": "mds2/laboratorio-pedidos",
    "description": "Sistema de pedidos del laboratorio refactorizado con patrones de diseño (Metodología de Sistemas II).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "lint": [
            "@lint:syntax",
            "@lint:style"
        ],
        "lint:syntax": "find src public views tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint:style": "phpcs",
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    }
}
